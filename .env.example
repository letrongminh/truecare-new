# TrueCare New staging environment contract.
# Copy values into AWS SSM Parameter Store SecureString under /truecare-new/staging/*.
# Do not commit real values.

# Public endpoints
PUBLIC_API_BASE_URL=https://truecare-new.noboil.dev
EXPO_PUBLIC_API_BASE_URL=https://truecare-new.noboil.dev
EXPO_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=<supabase-anon-key>

# Supabase server-side only
SUPABASE_PROJECT_REF=<project-ref>
SUPABASE_URL=https://<project-ref>.supabase.co
SUPABASE_SERVICE_ROLE_KEY=<server-only-service-role-key>
SUPABASE_JWT_SECRET=<server-only-realtime-jwt-secret>
DATABASE_URL_DIRECT=postgresql://postgres:<password>@db.<project-ref>.supabase.co:5432/postgres
DATABASE_URL_POOLER=postgresql://postgres.<project-ref>:<password>@aws-0-ap-southeast-1.pooler.supabase.com:6543/postgres

# Application auth and signing
JWT_SIGNING_PRIVATE_JWK=/run/secrets/jwt-signing-private.jwk.json
JWT_SIGNING_PUBLIC_JWKS=/run/secrets/jwt-signing-public.jwks.json
JWT_ISSUER=truecare-new-api
JWT_AUDIENCE=truecare-new

# AWS / EC2 / ECR
AWS_REGION=ap-southeast-1
AWS_ACCOUNT_ID=<aws-account-id>
EC2_INSTANCE_ID=<i-xxxxxxxxxxxxxxxxx>
ECR_REGISTRY=<aws-account-id>.dkr.ecr.ap-southeast-1.amazonaws.com
ECR_API_REPOSITORY=truecare-new-api
ECR_OPS_WEB_REPOSITORY=truecare-new-ops-web

# Cloudflare Tunnel
CLOUDFLARE_TUNNEL_ID=<tunnel-id>
CLOUDFLARE_TUNNEL_TOKEN=<server-only-cloudflared-token>
PUBLIC_HOSTNAME=truecare-new.noboil.dev

# Observability
SENTRY_DSN=<server-sentry-dsn>
SENTRY_ENVIRONMENT=staging
LOG_LEVEL=info

# Runtime image tags used by infra/compose/compose.staging.yml
TRUECARE_API_IMAGE=<ecr-registry>/truecare-new-api:<git-sha>
TRUECARE_WORKER_IMAGE=<ecr-registry>/truecare-new-api:<git-sha>
TRUECARE_OPS_WEB_IMAGE=<ecr-registry>/truecare-new-ops-web:<git-sha>
