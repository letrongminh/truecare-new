{
  "expo": {
    "name": "TrueCare",
    "slug": "truecare-new",
    "scheme": "truecare",
    "orientation": "portrait",
    "platforms": ["ios", "android"],
    "ios": {
      "bundleIdentifier": "vn.truecare.app"
    },
    "android": {
      "package": "vn.truecare.app"
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      "expo-camera",
      "expo-location",
      "expo-notifications"
    ]
  }
}
